{
  "Serilog": {
    "Using": [ "Elastic.Serilog.Sinks" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/Logs/ProjectBase/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] [{MachineName}] [{ThreadId}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30,
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600
        }
      },
      {
        // ZORUNLU: Prod'a çıkmadan önce "nodes" değerini gerçek Elasticsearch cluster adresinizle
        // değiştirin. Elastic.Serilog.Sinks yanlış/erişilemez bir adrese sessizce düşmez;
        // bağlantı hataları Program.cs'teki Serilog.Debugging.SelfLog ile stderr'e (ve varsa
        // container log toplayıcınıza) yazılır — Grafana'daki "no logs" durumunu buradan ayırt edin.
        "Name": "Elasticsearch",
        "Args": {
          "bootstrapMethod": "Failure",
          "nodes": [ "https://YOUR_ELASTIC_CLUSTER:9200" ],
          "indexFormat": "projectbase-logs-{0:yyyy.MM}"
        }
      }
      // {
      //   "Name": "Seq",
      //   "Args": { "serverUrl": "http://your-seq-server:5341" }
      // }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "https://your-production-frontend.com",
      "https://another-trusted-partner.com"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=PROD_PG_HOST;Port=5432;Database=ProjectBase;Username=YourUser;Password=YourSecurePassword",
    "HangfireConnection": "Host=PROD_PG_HOST;Port=5432;Database=ProjectBaseHangfire;Username=YourUser;Password=YourSecurePassword"
  },
  "Auth": {
    "Authority": "https://your-identity-server.com",
    "ApiName": "your_production_api_name"
  },
  "ExternalServices": {
    "ProductApiBaseUrl": "https://api.external-products.com/"
  }
}